# VoxProof Environment Variables
# Copy this file to .env and update values

# API Authentication Key (MUST be set - use a strong random 128-bit key)
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
API_KEY=your-128-bit-random-key-here

# Model Configuration
MODEL_PATH=model/classifier.pth
WAV2VEC_MODEL=facebook/wav2vec2-base-960h
SAMPLE_RATE=16000

# Production Mode (Hugging Face Spaces sets this automatically)
PRODUCTION=false

# Server Port (automatically set by platform in production)
# Local: PORT=8000
# HF Spaces: PORT is set by the platform
